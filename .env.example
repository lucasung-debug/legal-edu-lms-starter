# 대부분의 설정은 관리자 화면에서 할 수 있어 이 파일은 없어도 됩니다.
# 서버에 설치하는 경우 등 필요할 때만 복사해 같은 폴더에 `.env` 로 저장하세요.
# .env 에는 비밀번호가 들어가므로 다른 사람과 공유하지 마세요.

# 포트 (기본 3000)
# PORT=3000

# 설정 마법사 없이 관리자 계정을 만들 때 (처음 실행 시에만 사용, 첫 로그인 때 변경)
# ADMIN_PASSWORD=

# 메일 (관리자 화면 > 설정 > 메일 연결에서 입력하면 자동으로 저장됩니다)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_FROM_NAME=HR팀 법정교육

# Google 드라이브 영상 직접 재생 (선택)
# DRIVE_API_KEY=
